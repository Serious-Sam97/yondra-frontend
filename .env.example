# Local backend API (Laravel on docker, published on 8001).
NEXT_PUBLIC_API=http://localhost:8001

# Reverb (realtime WebSocket) — the BROWSER connects to the reverb docker service via the
# host's published port (localhost:8080). The app key MUST match yondra/.env REVERB_APP_KEY.
NEXT_PUBLIC_REVERB_APP_KEY=yondra-local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
